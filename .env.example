# ── 분실물 감지 AI 시스템 환경설정 ─────────────────────────────
# 이 파일을 .env 로 복사한 뒤 값을 채워 넣으세요.
# 여기 값들은 "기본값"이며, 웹 관리자 페이지의 [설정]에서 저장하면 그 값이 우선 적용됩니다.

# 카메라 소스: 웹캠 번호(0, 1, ...) 또는 동영상 파일 경로
CAMERA_SOURCE=0

# AI 공급자: auto | openai | gemini | mock
#  - auto: 키가 있는 공급자를 자동 선택 (openai 우선), 키가 없으면 mock
#  - mock: API 키 없이 시연용 (물체 이름은 '미확인 물품'으로 등록됨)
AI_PROVIDER=auto
OPENAI_API_KEY=
GEMINI_API_KEY=

# 관리자 알림 메일
ADMIN_EMAIL=
# Gmail 기준: smtp.gmail.com / 587 / 본인 Gmail 주소 / 앱 비밀번호(16자리)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# 서버 포트
PORT=8000
